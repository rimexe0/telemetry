<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows: the widget's own look with example rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111213"
    android:orientation="vertical"
    android:padding="12dp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="Habits 1 of 3 · 1 h 30 min left"
        android:textColor="#eeeeeb"
        android:textSize="13sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="monospace"
        android:text="■  Walk outside"
        android:textColor="#aaa9a4"
        android:textSize="14sp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="monospace"
        android:text="□  Stretch"
        android:textColor="#eeeeeb"
        android:textSize="14sp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="monospace"
        android:text="□  Read"
        android:textColor="#eeeeeb"
        android:textSize="14sp" />
</LinearLayout>
