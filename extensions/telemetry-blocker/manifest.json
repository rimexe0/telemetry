{
  "manifest_version": 3,
  "name": "Telemetry",
  "version": "0.9.4",
  "update_url": "http://127.0.0.1:5600/api/telemetry/extension.xml",
  "description": "Covers sites your Telemetry plan blocks right now with the reason, without losing the page, or hides their feeds where a page may stay open.",
  "permissions": [
    "tabs",
    "alarms",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:5600/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Telemetry",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "cover.js"
      ],
      "run_at": "document_start"
    }
  ]
}
