{
  "manifest_version": 3,
  "name": "Telemetry",
  "version": "0.5.0",
  "description": "Covers sites your Telemetry plan blocks right now with the reason, without losing the page.",
  "permissions": [
    "tabs",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:5600/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Telemetry",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "cover.js"
      ],
      "run_at": "document_start"
    }
  ]
}
