<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.rime.telemetry.guard</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/ri/Applications/Telemetry Desktop.app/Contents/MacOS/telemetry-desktop</string>
    <string>guard</string>
    <string>-label</string>
    <string>com.rime.telemetry.desktop</string>
    <string>-plist</string>
    <string>/Users/ri/Library/LaunchAgents/com.rime.telemetry.desktop.plist</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!-- Every minute: starts the collector again if it was unloaded. -->
  <key>StartInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>/Users/ri/Library/Application Support/Telemetry/guard.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ri/Library/Application Support/Telemetry/guard.log</string>
</dict>
</plist>
