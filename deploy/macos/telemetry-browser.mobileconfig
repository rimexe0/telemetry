	<key>PayloadDescription</key>
	<string>Installs the Telemetry extension in Helium and other Chromium browsers by policy, so it cannot be switched off or removed in the browser and updates by itself. Chromium force-installs extensions from outside the Web Store only on a Mac with a configuration profile.</string>
	<key>PayloadDisplayName</key>
	<string>Telemetry browser extension</string>
	<key>PayloadIdentifier</key>
	<string>cyou.rime.telemetry.browser</string>
	<key>PayloadOrganization</key>
	<string>Telemetry</string>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>11AD1BC1-996A-5F3D-B5AA-65BA1E70BB2C</string>
