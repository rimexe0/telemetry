<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The browser extension is installed by policy, so it cannot be removed
       or switched off in chrome://extensions. The collector serves the packed
       and signed copy on the loopback address. -->
  <key>ExtensionInstallForcelist</key>
  <array>
    <string>fachbjhigbkfbbplbnoephgnkgghhbfa;http://127.0.0.1:5600/api/telemetry/extension.xml</string>
  </array>
  <!-- Updates come from the collector too: without this the browser asks
       the address in the extension's own manifest, and copies installed
       before it named one ask the Chrome Web Store, which never answers. -->
  <key>ExtensionSettings</key>
  <dict>
    <key>fachbjhigbkfbbplbnoephgnkgghhbfa</key>
    <dict>
      <key>installation_mode</key>
      <string>force_installed</string>
      <key>update_url</key>
      <string>http://127.0.0.1:5600/api/telemetry/extension.xml</string>
      <key>override_update_url</key>
      <true/>
    </dict>
  </dict>
</dict>
</plist>
