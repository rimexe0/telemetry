<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.rime.telemetry.update</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/ri/Library/Application Support/Telemetry/bin/telemetry-update</string>
  </array>
  <!-- Checks for a new release every ten minutes; see telemetry-update.sh. -->
  <key>StartInterval</key>
  <integer>600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/ri/Library/Application Support/Telemetry/update.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ri/Library/Application Support/Telemetry/update.log</string>
</dict>
</plist>
