[Unit]
Description=Hourly Telemetry offsite PostgreSQL snapshot replication

# Every hour: the offsite machine (the CachyOS desktop) is often off, so a
# copy that cannot reach it tries again the next hour. The newest snapshot
# is checked each run; snapshots already copied are not sent again.
[Timer]
OnCalendar=hourly
RandomizedDelaySec=10m
Persistent=true
Unit=telemetry-backup-offsite.service

[Install]
WantedBy=timers.target
